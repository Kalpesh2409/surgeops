{
  "name": "surgeops-api",
  "version": "0.1.0",
  "description": "SurgeOps backend API - Node.js + Express + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
